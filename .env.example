# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 組織切替（app_metadata の更新）に必要。Auth Admin API 専用でサーバー側のみ。
# NEXT_PUBLIC_ を付けないこと（クライアントに露出すると RLS が全て無意味になる）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase DB (Drizzle ORM direct connection via pooler)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# App URL（パスワードリセット等のメールリンク生成に使用）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# デモ環境の閲覧専用モード（任意）
# 設定した組織 ID への書き込みを Service Layer が拒否する。
# 公開デモが荒らされるのを防ぐためのもので、ローカル開発では設定しない。
# 未設定なら何も起きない。詳細は docs/adr/0012-demo-org-is-read-only.md
# DEMO_READONLY_ORG_ID=

# Anthropic (AI features)
ANTHROPIC_API_KEY=your-anthropic-api-key
